              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 1,\n  \"event_id\": 1,\n  \"seats\": 2\n}"
            },
            "url": "{{baseUrl}}/api/bookings"
          }
        },
        {
          "name": "Get Bookings",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/bookings"
