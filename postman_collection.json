          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Node.js Workshop\",\n  \"description\": \"Node.js backend workshop\",\n  \"category\": \"workshop\",\n  \"date\": \"2026-11-15T15:00:00.000Z\",\n  \"location\": \"IT Park\",\n  \"city\": \"Toshkent\",\n  \"price\": 100000,\n  \"total_seats\": 50\n}"
            },
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "Get Events",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events?search=node&city=Toshkent&free=true&sort=date_asc&page=1&limit=5"
          }
        },
        {
          "name": "Get Event",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events/{{eventId}}"
          }
        },
        {
          "name": "Update Event",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Node.js Workshop\",\n  \"description\": \"Updated description\",\n  \"price\": 120000,\n  \"total_seats\": 60\n}"
            },
            "url": "{{baseUrl}}/api/events/{{eventId}}"
          }
        },
        {
          "name": "Delete Event",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/events/{{eventId}}"
          }
        },
